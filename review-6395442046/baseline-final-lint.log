 407 | /**
 408 |  * Read a File as text
 409 |  */
 410 | function readFileAsText(file: File): Promise<string> {
 411 |   return new Promise((resolve, reject) => {
 412 |     const reader = new FileReader();
 413 |     reader.onload = () => resolve(reader.result as string);
 414 |     reader.onerror = () => reject(reader.error);
 415 |     reader.readAsText(file);
 416 |   });
 417 | }
