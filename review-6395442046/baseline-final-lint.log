 419 | // ============================================================================
 420 | // Ignore Pattern Handling (simplified version of ignore package)
 421 | // ============================================================================
 422 | 
 423 | /**
 424 |  * Simple ignore pattern matching
 425 |  * Supports basic glob patterns: *, ?, **
 426 |  */
 427 | export function shouldIgnore(filePath: string, patterns: string[]): boolean {
 428 |   const normalizedPath = filePath.toLowerCase();
 429 |   for (const pattern of patterns) {
 430 |     const trimmedPattern = pattern.trim();
 431 |     if (!trimmedPattern || trimmedPattern.startsWith('#')) continue;
 432 | 
 433 |     if (matchPattern(normalizedPath, trimmedPattern.toLowerCase())) {
 434 |       return true;
 435 |     }
 436 |   }
 437 |   return false;
 438 | }
 439 | 
 440 | function matchPattern(filePath: string, pattern: string): boolean {
 441 |   // Handle directory patterns (trailing slash)
 442 |   if (pattern.endsWith('/')) {
 443 |     const dirPattern = pattern.slice(0, -1);
 444 |     return filePath.startsWith(dirPattern + '/') || filePath === dirPattern;
 445 |   }
 446 | 
 447 |   // Handle exact match
 448 |   if (filePath === pattern) return true;
 449 | 
 450 |   // Handle glob patterns
 451 |   const regex = globToRegex(pattern);
 452 |   return regex.test(filePath);
 453 | }
 454 | 
 455 | function globToRegex(pattern: string): RegExp {
 456 |   let regex = '';
 457 |   let i = 0;
 458 | 
 459 |   while (i < pattern.length) {
 460 |     const c = pattern[i];
 461 | 
 462 |     if (c === '*') {
 463 |       if (pattern[i + 1] === '*') {
 464 |         // ** matches any number of directories
 465 |         regex += '.*';
 466 |         i += 2;
 467 |       } else {
 468 |         // * matches any characters except /
 469 |         regex += '[^/]*';
 470 |         i++;
 471 |       }
 472 |     } else if (c === '?') {
 473 |       // ? matches any single character except /
 474 |       regex += '[^/]';
 475 |       i++;
 476 |     } else if (c === '.') {
 477 |       regex += '\\.';
 478 |       i++;
 479 |     } else if (
 480 |       c === '\\' ||
 481 |       c === '/' ||
 482 |       c === '$' ||
 483 |       c === '^' ||
 484 |       c === '+' ||
 485 |       c === '(' ||
 486 |       c === ')' ||
 487 |       c === '[' ||
 488 |       c === ']' ||
 489 |       c === '{' ||
 490 |       c === '}'
 491 |     ) {
 492 |       regex += '\\' + c;
 493 |       i++;
 494 |     } else {
 495 |       regex += c;
 496 |       i++;
 497 |     }
 498 |   }
 499 | 
 500 |   return new RegExp(`^${regex}$`);
 501 | }
